# PostgreSQL (Neon) - Prisma
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST-POOLER.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neo4j (docker-compose)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"
NEO4J_DATABASE="neo4j"

# Auth
JWT_SECRET="cambiar-mas-adelante"
SEED_ADMIN_EMAIL="admin@rutas.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_NOMBRE="Administrador"

# Geocoding (OpenStreetMap/Nominatim)
GEO_BASE_URL="https://nominatim.openstreetmap.org"
GEO_USER_AGENT="management-delivery-routes/1.0"
GEO_TIMEOUT_MS="8000"
GEO_MIN_INTERVAL_MS="1000"
# true: rechaza el pedido si no se puede geocodificar (422)
# false: lo crea sin coordenadas y se excluye de la optimización
GEO_ESTRICTO="false"
