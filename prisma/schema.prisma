generator client {
  provider = "prisma-client"
  output   = "../Backend/src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Pedido {
  id            Int                  @id @default(autoincrement())
  prioridad     String
  tipoEntrega   String
  zona          String
  idCentro      Int
  idCoordinador Int
  centro        CentroDeDistribucion @relation("Pertenece", fields: [idCentro], references: [id])
  coordinador   CoordinadorLogistico @relation("Ingresa", fields: [idCoordinador], references: [id])
}

model CentroDeDistribucion {
  id                      Int                    @id @default(autoincrement())
  nombre                  String
  programaLogistico       String
  pedidos                 Pedido[]               @relation("Pertenece")
  repartidores            Repartidor[]           @relation("Asignar")
  coordinadorCrearRutas   CoordinadorLogistico[] @relation("Crear Rutas")
  zonas                   Zona[]                 @relation("Cubre")
  coordinadorValidadRutas CoordinadorLogistico[] @relation("Validar Rutas")
}

model Zona {
  id      Int                    @id @default(autoincrement())
  nombre  String
  centros CentroDeDistribucion[] @relation("Cubre")
  rutas   Ruta[]                 @relation("CubrirZonas")
}

model Ruta {
  id                           Int                 @id @default(autoincrement())
  cantidadTotalPedidos         Int
  idLogistico                  Int
  idSupervisor                 Int
  parametros                   String
  proporcionPedidosTipoEntrega Int
  logistico                    Logistico           @relation("RutasCreadas", fields: [idLogistico], references: [id])
  supervisor                   SupervisorLogistico @relation("RutasSupervisadas", fields: [idSupervisor], references: [id])
  zonasCubiertas               Zona[]              @relation("CubrirZonas")
  paradas                      Parada[]            @relation("Pertence")
}

model CoordinadorLogistico {
  id                 Int                    @id @default(autoincrement())
  nombre             String
  especialidad       String
  logisticos         Logistico[]            @relation("Logistico-CoodinadorLogistico")
  ingresarPedidos    Pedido[]               @relation("Ingresa")
  supervisores       SupervisorLogistico[]  @relation("SupervisorLogistico-CoodinadorLogistico")
  reportes           Reporte[]              @relation("ConsultaC")
  centrosCrearRuta   CentroDeDistribucion[] @relation("Crear Rutas")
  centrosValidarRuta CentroDeDistribucion[] @relation("Validar Rutas")
}

model Logistico {
  id            Int                  @id @default(autoincrement())
  idCoordinador Int
  coordinador   CoordinadorLogistico @relation("Logistico-CoodinadorLogistico", fields: [idCoordinador], references: [id])
  rutas         Ruta[]               @relation("RutasCreadas")
}

model SupervisorLogistico {
  id            Int                  @id @default(autoincrement())
  idCoordinador Int
  rutas         Ruta[]               @relation("RutasSupervisadas")
  coordinador   CoordinadorLogistico @relation("SupervisorLogistico-CoodinadorLogistico", fields: [idCoordinador], references: [id])
}

model Realizar {
  id           Int  @id @default(autoincrement())
  repartidorId Int? @unique
  vehiculoId   Int? @unique
  rutaId       Int
}

model Repartidor {
  id       Int                    @id @default(autoincrement())
  nombre   String
  edad     Int
  flotaID  Int
  flota    Flota                  @relation("Pertenecer", fields: [flotaID], references: [id])
  centros  CentroDeDistribucion[] @relation("Asignar")
  reportes Reporte[]              @relation("ConsultaR")
}

model Flota {
  id           Int          @id @default(autoincrement())
  nombre       String
  repartidores Repartidor[] @relation("Pertenecer")
  vehiculos    Vehiculo[]   @relation("Pertenecer")
}

model Vehiculo {
  id        Int   @id @default(autoincrement())
  capacidad Int
  flotaID   Int
  flota     Flota @relation("Pertenecer", fields: [flotaID], references: [id])
}

model Parada {
  id              Int    @id @default(autoincrement())
  estadoEjecucion String
  rutas           Ruta[] @relation("Pertence")
}

model Reporte {
  id            Int                    @id @default(autoincrement())
  fecha         DateTime
  descripcion   String
  idRepartidor  Int
  coordinadores CoordinadorLogistico[] @relation("ConsultaC")
  repartidores  Repartidor[]           @relation("ConsultaR")
}

model Reprogramar {
  id              Int      @id @default(autoincrement())
  idCoordinador   Int
  idRepartidor    Int      @unique
  idRuta          Int
  fechaSolicitada DateTime
  fechaResultado  DateTime
}

model User {
  email String @unique
  password String
}